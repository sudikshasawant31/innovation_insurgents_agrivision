ML_SERVICE_URL=http://127.0.0.1:8000
CORS_ORIGINS=http://localhost:3000

# Firebase web app config (client SDK - used for session + Firestore only)
NEXT_PUBLIC_FIREBASE_API_KEY=replace-me
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=replace-me

# Firebase Admin (server only) - used to mint custom sign-in tokens after
# Twilio verifies a phone OTP or Google OAuth succeeds.
# Option A: paste the full service-account JSON as one line
FIREBASE_SERVICE_ACCOUNT_JSON=
# Option B: or split it into three vars instead of using the JSON blob above
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Twilio Verify (phone OTP)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=

# Google OAuth (server-side client id/secret flow, not the Firebase Google provider)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
